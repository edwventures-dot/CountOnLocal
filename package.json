{
  "name": "countonlocal",
  "version": "0.1.0",
  "description": "Count On Local - neighborhood microbusiness platform",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "migrate:status": "node --env-file=.env.local scripts/migrate.mjs --status",
    "db:verify": "node --env-file=.env.local scripts/verify-schema.mjs",
    "db:verify:rls": "node --env-file=.env.local scripts/verify-rls.mjs",
    "test:integration": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:http": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.http.config.ts",
    "waitlist": "node --env-file=.env.local scripts/waitlist.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edwventures-dot/CountOnLocal.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/edwventures-dot/CountOnLocal/issues"
  },
  "homepage": "https://github.com/edwventures-dot/CountOnLocal#readme",
  "private": "true",
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "next": "^16.3.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  }
}
