# Copy to .env.local and fill in from your Supabase project settings.
# .env.local is gitignored. Never commit real values, and never paste them
# into a chat transcript.

# Project URL and anon key -- safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key -- SERVER ONLY. Bypasses row level security.
# TECHNICAL_SPEC section 16: privileged credentials stay separate from
# public frontend keys. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Salt for hashing IP addresses in the audit log so raw IPs are never stored.
AUDIT_IP_HASH_SALT=generate-a-long-random-string

# --- Postgres connection string, for migrations only ---
# Supabase dashboard: Project Settings > Database > Connection string > URI
# Contains the database password. Never commit it, never paste it in chat.
# If the direct connection will not open, use the Session pooler string.
DATABASE_URL=

# --- Stripe (test mode) ---
# Dashboard: https://dashboard.stripe.com/test/apikeys
# Webhook secret comes from the CLI or the webhook endpoint you create.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Pre-launch gate ---
# While this is up, only the landing page and POST /v1/waitlist answer.
# Everything else returns 404 -- see src/lib/prelaunch.ts for why 404 and
# not 403.
#
#   unset  gated in production, open in development  (the default)
#   on     gated everywhere, for rehearsing it locally
#   off    lifted -- the whole marketplace is public
#
# Do not set this to "off" in production until README's five launch
# approvals are actually in hand: US legal review of marketplace terms and
# minor participation, insurance, payment-processor sign-off on the final
# Connect setup, state-by-state service restrictions, and trademark.
PRELAUNCH=

# --- Scheduled jobs ---
# Shared secret for /api/jobs/daily. Vercel Cron sends it automatically as
# `Authorization: Bearer $CRON_SECRET` once this variable exists on the
# project, so the value only has to be set, never wired up by hand.
#
# With this unset the endpoint refuses everything rather than running open.
# An unauthenticated caller must not be able to make the platform charge
# cards, and "the secret was not configured" is not a reason to allow it.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# --- Notifications ---
# No provider is wired yet. Until one is registered with setNotifier(),
# every send fails permanently and says so -- a notification that silently
# vanishes is the exact failure the outbox exists to prevent, so it refuses
# loudly instead.
#
# When you pick one (Resend, Postmark, SES): send AS an address at your own
# domain, verified with DKIM and SPF records added at your DNS host. Do not
# relay through a mailbox provider -- rate caps, no bounce webhooks, no
# suppression list, and shared-IP reputation you do not control.
#
# One SPF record per domain, ever. If your DNS host already publishes one
# for mailbox email, merge the provider's include: into it. Two SPF TXT
# records is a hard fail, not a warning.
NOTIFICATIONS_FROM_EMAIL=
NOTIFICATIONS_PROVIDER_API_KEY=
